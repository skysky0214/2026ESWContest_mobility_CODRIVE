[Unit]
Description=CODRIVE cabin camera DMS publisher
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/EWS/ESW2026-integration
Environment=CODRIVE_LOG_TO_FILE=1
ExecStartPre=/bin/bash %h/EWS/ESW2026-integration/scripts/wait-wired-clock.sh enP8p1s0 192.168.50.22/24
TimeoutStartSec=210
ExecStart=/bin/bash %h/EWS/ESW2026-integration/scripts/run-cabin.sh
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGINT
SuccessExitStatus=130

[Install]
WantedBy=default.target
